<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Owner Control Panel"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_manage_products"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Manage Products, Photos &amp; Prices"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_manage_banners"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Home Banners &amp; Layout Manager"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_store_orders"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Store Orders &amp; Customer Analytics"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_app_version_info"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="App Version &amp; Software Updates"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Secure Owner Logout"
            android:textSize="16sp"
            android:backgroundTint="#D32F2F"
            app:cornerRadius="16dp" />

    </LinearLayout>
</ScrollView>