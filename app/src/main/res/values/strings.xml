    <string name="about_history_title">34 Years of Pure Cobbler Dedication</string>
    <string name="about_history_detail">New Samadhan Shoe Mart was founded in 1990 in Nashik, Maharashtra. Our founder walked into Plot No. 29, Santkrupa Niwas with one conviction: footwear should feel like an extension of the body. Three decades and 50,000+ pairs later, we remain true to that vision — stitched at 12 stitches per inch with bonded German nylon, cut parallel to leather tension lines, fused under 80-bar pneumatic pressure. Visit our website: https://new-samadhan-shoes-mart.vercel.app/</string>

    <string name="title_our_values">The Principles We Never Compromise</string>
    <string name="value_1_title">Artisan First</string>
    <string name="value_1_desc">Every pair is touched by human hands at every stage. No automated moulding. No shortcuts. Just craft.</string>
    <string name="value_2_title">Heritage Pride</string>
    <string name="value_2_desc">34 years of cobbler dedication embedded in every stitch, every skive, and every welt loop.</string>
    <string name="value_3_title">Lifetime Promise</string>
    <string name="value_3_desc">Goodyear welt means you can resole our shoes multiple times. Built to outlast trends, not follow them.</string>
    <string name="value_4_title">Zero Fatigue Fit</string>
    <string name="value_4_desc">32 anatomical landmarks per last ensure glove-like comfort from hour one. No break-in period needed.</string>
    <string name="value_5_title">Museum Grade Finish</string>
    <string name="value_5_desc">24-hour bone-burnished carnauba wax patina. The leather improves with age — like fine wine.</string>
    <string name="value_6_title">Sustainable Sourcing</string>
    <string name="value_6_desc">Vegetable-tanned full-grain leathers from certified tanneries. Zero PVC coatings. Nature-forward.</string>

    <string name="milestone_1_year">1990</string>
    <string name="milestone_1_title">The Founding Vision</string>
    <string name="milestone_1_desc">New Samadhan Shoe Mart was born in the cultural heart of Nashik with a purpose to craft footwear that feels like a second skin.</string>
    <string name="milestone_2_year">1998</string>
    <string name="milestone_2_title">Goodyear Welt Mastery</string>
    <string name="milestone_2_desc">The atelier adopted Goodyear welted construction — the gold standard of durable, resoleable footwear.</string>
    <string name="milestone_3_year">2005</string>
    <string name="milestone_3_title">The Guild Expands</string>
    <string name="milestone_3_desc">Welcomed 6 new master artisans. The workshop floor tripled to meet growing Nashik demand.</string>
    <string name="milestone_4_year">2012</string>
    <string name="milestone_4_title">50,000 Pairs Milestone</string>
    <string name="milestone_4_desc">Celebrated crafting 50,000 handmade pairs — each signed off by a Guild Elder.</string>
    <string name="milestone_5_year">2018</string>
    <string name="milestone_5_title">Digital Showroom Launch</string>
    <string name="milestone_5_desc">Took the heritage online — bringing Nashik\'s finest cobbling tradition to customers everywhere.</string>
    <string name="milestone_6_year">2024</string>
    <string name="milestone_6_title">Present Day Excellence</string>
    <string name="milestone_6_desc">34 years later, still handcrafting every pair with the same precision, passion and patina-philosophy.</string>

